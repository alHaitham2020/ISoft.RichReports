<Project>

  <PropertyGroup Label="Language">
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Quality gates">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- A temporarily unreachable NuGet feed must not break the build because of the vulnerability audit. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Metadata">
    <Company>ISoft</Company>
    <Authors>ISoft</Authors>
    <Product>ISoft RichReports</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
